# Robot Gateway Configuration
# Add these to Dolly's .env file to enable robot connectivity.

# Enable robot gateway (set to true to connect to robot-service)
ROBOT_GATEWAY_ENABLED=false

# Robot-service base URL (change to robot's LAN IP)
ROBOT_GATEWAY_URL=http://192.168.123.15:8780

# Optional: Bearer token for robot API authentication
ROBOT_AUTH_TOKEN=

# Health check interval (seconds)
ROBOT_HEALTH_INTERVAL_S=5.0

# State polling interval (seconds)
ROBOT_STATE_INTERVAL_S=0.5