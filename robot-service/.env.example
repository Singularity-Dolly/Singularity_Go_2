# ---------------------------------------------------------------------------
# Singularity Go2 — robot-service environment configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and customize for your deployment.
#   cp .env.example .env
#
# All settings are prefixed with GATEWAY_ to avoid collisions with
# DimOS or other modules.
# ---------------------------------------------------------------------------

# Robot identity (unique per robot, e.g. "go2-001", "go2-edu-42")
GATEWAY_ROBOT_ID=unknown

# HTTP server bind address and port
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8780

# Optional Bearer token for API authentication
# If set, all requests must include: Authorization: Bearer <token>
# GATEWAY_AUTH_TOKEN=

# Robot IP address (for direct Unitree SDK2 connection)
# Usually 192.168.123.161 for Go2 default network
# GATEWAY_ROBOT_IP=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
GATEWAY_LOG_LEVEL=INFO

# Command execution timeout (seconds)
# Commands taking longer than this are rejected with timeout error
GATEWAY_COMMAND_TIMEOUT_S=5.0

# Heartbeat watchdog configuration
# Interval: how often to check heartbeat freshness
# Timeout: how long without heartbeat before triggering emergency stop
GATEWAY_HEARTBEAT_INTERVAL_S=0.5
GATEWAY_HEARTBEAT_TIMEOUT_S=1.5

# Maximum number of pending commands in the queue
GATEWAY_MAX_QUEUE_SIZE=8

# Maximum age of a camera frame before it's considered stale (seconds)
# Stale frames return 503 instead of sending outdated data
GATEWAY_FRAME_MAX_AGE_S=0.5